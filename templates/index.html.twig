{% extends "@Contao/be_main.html.twig" %}

{% block main_content %}
    <div class="maintenance_inactive">
        {{ messages | raw }}

        <fieldset class="tl_box" id="pal_system_load" data-controller="contao--toggle-fieldset" data-contao--toggle-fieldset-id-value="system_load" data-contao--toggle-fieldset-collapsed-class="collapsed">
            <legend>
                <button type="button" data-action="contao--toggle-fieldset#toggle">{{ 'bwein.system_info.legend_load'|trans }}</button>
            </legend>

            {% include '@BweinSystemInformation/system_load.html.twig' with {
                'systemLoadInfo': systemLoadInfo
            } %}
        </fieldset>

        <fieldset class="tl_box" id="pal_software" data-controller="contao--toggle-fieldset" data-contao--toggle-fieldset-id-value="software" data-contao--toggle-fieldset-collapsed-class="collapsed">
            <legend>
                <button type="button" data-action="contao--toggle-fieldset#toggle">{{ 'bwein.system_info.legend_software'|trans }}</button>
            </legend>

            <div class="w50">
                {% include '@BweinSystemInformation/os_info.html.twig' with {
                    'osInfo': osInfo
                } %}
            </div>
            <div class="w50">
                {% include '@BweinSystemInformation/virtualization_info.html.twig' with {
                    'virtualizationInfo': virtualizationInfo
                } %}
            </div>

            <div class="clear"></div>

            <div class="w50">
                {% include '@BweinSystemInformation/php_info.html.twig' with {
                    'phpInfo': phpInfo
                } %}
            </div>
            <div class="w50">
                {% include '@BweinSystemInformation/database_info.html.twig' with {
                    'databaseInfo': databaseInfo
                } %}
            </div>
        </fieldset>

        <fieldset class="tl_box" id="pal_hardware" data-controller="contao--toggle-fieldset" data-contao--toggle-fieldset-id-value="hardware" data-contao--toggle-fieldset-collapsed-class="collapsed">
            <legend>
                <button type="button" data-action="contao--toggle-fieldset#toggle">{{ 'bwein.system_info.legend_hardware'|trans }}</button>
            </legend>

            <div class="w50">
                {% include '@BweinSystemInformation/hardware_info.html.twig' with {
                    'hardwareInfo': hardwareInfo
                } %}
            </div>
            <div class="w50">
                {% include '@BweinSystemInformation/host_info.html.twig' with {
                    'hostInfo': hostInfo
                } %}
            </div>
        </fieldset>
    </div>
{% endblock %}
